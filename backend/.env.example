# Copy values into your shell (export ...) before starting the API.
# Optional: without a key, /ask runs in extractive (evidence-only) mode.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# Where uploaded policies and extracted chunks are stored (git-ignored).
DATA_DIR=../data/runtime
# Minimum TF-IDF cosine score for a passage to count as evidence.
MIN_EVIDENCE_SCORE=0.08
RETRIEVAL_TOP_K=5
MAX_UPLOAD_MB=20
