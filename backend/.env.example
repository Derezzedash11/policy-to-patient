# Copy values into your shell (export ...) before starting the API.
# Optional: without a key, /ask runs in extractive (evidence-only) mode.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# Where uploaded policies, local vectors and downloaded models are stored (git-ignored).
DATA_DIR=../data/runtime

# Embeddings: fastembed (local semantic model, needs backend[embeddings]) or
# hashing (offline, deterministic, lexical - NOT semantic; for tests/demos without a model).
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector store: PostgreSQL + pgvector when set (needs backend[pgvector]); otherwise local files.
DATABASE_URL=
# DATABASE_URL=postgresql://p2p:p2p@localhost:5432/p2p

# Minimum cosine similarity for a passage to count as evidence.
# Leave empty to use the embedder's default (uncalibrated; tune on an evaluation set).
MIN_EVIDENCE_SCORE=
RETRIEVAL_TOP_K=5
MAX_UPLOAD_MB=20
