# Copy values into your shell (export ...) before starting the API.
# Optional: without a key for the selected provider, /ask runs in extractive (evidence-only) mode.
# LLM_PROVIDER: anthropic (default) or gemini (needs backend[gemini]).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Where uploaded policies, local vectors and downloaded models are stored (git-ignored).
DATA_DIR=../data/runtime

# Embeddings: fastembed (local semantic model, needs backend[embeddings]) or
# hashing (offline, deterministic, lexical - NOT semantic; for tests/demos without a model).
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector store: PostgreSQL + pgvector when set (needs backend[pgvector]); otherwise local files.
DATABASE_URL=
# DATABASE_URL=postgresql://p2p:p2p@localhost:5432/p2p

# Minimum cosine similarity for a passage to count as evidence.
# Leave empty to use the embedder's default (uncalibrated; tune on an evaluation set).
MIN_EVIDENCE_SCORE=
RETRIEVAL_TOP_K=5
# Self-correcting retrieval: how many times Claude may rewrite a query when no passage passes
# the threshold (0 disables; capped at 2). Needs an LLM provider key.
MAX_QUERY_REWRITES=1
# Built UI served at /ui/ (run `npm run build` in frontend/). Default: ../frontend/dist
FRONTEND_DIST=
MAX_UPLOAD_MB=20
